aws_region   = "eu-central-1"
project_name = "home-assessment"
environment  = "prod"

cdn_bucket_name = "CHANGE_ME_UNIQUE_PROD_BUCKET"

github_org  = "Giou3"
github_repo = "home-assessment"

# For a first `terraform plan`, any image URI is fine. For a working ECS+ALB deploy, use your ECR image
# or a public sample that listens on `app_port` (default 8080). hello-app returns 200 for any path, so /healthz works.
container_image = "gcr.io/google-samples/hello-app:1.0"
